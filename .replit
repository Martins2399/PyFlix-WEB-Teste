entrypoint = "server.py"
modules = ["web", "python-base-3.13", "nodejs-24"]

[deployment]
deploymentTarget = "autoscale"
run = ["env", "APP_ENV=production", "gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "server:app"]
build = ["pip", "install", "-r", "requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start PyFlix"

[[workflows.workflow]]
name = "Start PyFlix"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./.pythonlibs/bin/python server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
